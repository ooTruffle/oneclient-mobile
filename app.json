{
  "expo": {
    "name": "OneClient Mobile",
    "slug": "oneclient-mobile",
    "version": "1.1.0",
    "scheme": "oneclient",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131319",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "org.polyfrost.oneclient.mobile",
      "appleTeamId": "P45WCVSG2P",
      "supportsTablet": true
    },
    "android": {
      "package": "org.polyfrost.oneclient.mobile",
      "versionCode": 13,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/monochrome-icon.png",
          "color": "#2567d8"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#131319"
        }
      ],
      "./plugins/with-no-push",
      "./plugins/with-ios-scene-lifecycle"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85d8e956-53b6-4351-9311-c59696b66042"
      }
    },
    "owner": "ootruffle"
  }
}
